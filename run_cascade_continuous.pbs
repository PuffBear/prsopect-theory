#!/bin/bash
#PBS -N exp_cascade_cont
#PBS -o logs/cascade_continuous.out
#PBS -e logs/cascade_continuous.err
#PBS -l ncpus=1
#PBS -l walltime=06:00:00
#PBS -q cpu
#PBS -J 0-1099

# Reviewer point 3: thicken the cascade. Arm A = single lambda=7 node at every
# position (5 cells); Arm B = fixed downstream node, continuous lambda (6 cells).
# 11 cells x 5 w x 20 seeds = 1100 runs.
cd "$PBS_O_WORKDIR"
mkdir -p logs
module load compiler/anaconda3
eval "$(conda shell.bash hook)"
conda activate marl

python3 experiments/exp_cascade_continuous.py \
    --run_idx "${PBS_ARRAY_INDEX}" \
    --timesteps 300000 \
    --out docs/expCascade_continuous_figures/cascade_continuous_raw_data.csv
