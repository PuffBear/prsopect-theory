#!/bin/bash
#PBS -N ppo_mpe_v2
#PBS -q cpu
#PBS -J 0-659
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=10:00:00
#PBS -j oe
set -euo pipefail
PROJECT_ROOT="$HOME/prospect-theory"
cd "$PROJECT_ROOT"
mkdir -p logs docs/expPPO_mpe_figures
exec >> "$PROJECT_ROOT/logs/ppo_mpe_v2_${PBS_ARRAY_INDEX}.log" 2>&1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
source /apps/miniconda3/etc/profile.d/conda.sh
conda activate marl

# v2 sweep: 330 runs = w(11) x condition{null,curvature,lambda3} x 10 seeds.
# PRE-CONDITIONS (all must hold before qsub):
#   1. local smoke test passed (run_mpe_smoke_local.py --train)
#   2. calibration array finished and analyze_mpe_calibrate.py printed
#      "Gate PASSED" (docs/exp_mpe/mpe_collapse_threshold_v2.json,
#      clean_separation=true)
python experiments/exp_ppo_mpe.py \
    --run_idx "$PBS_ARRAY_INDEX" \
    --timesteps 4000000 \
    --out docs/expPPO_mpe_figures/ppo_mpe_v2_raw_data.csv
