#!/bin/bash
#PBS -N ppo_lbf_v2
#PBS -q cpu
#PBS -J 0-329
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=08:00:00
#PBS -j oe
set -euo pipefail
PROJECT_ROOT="$HOME/prospect-theory"
cd "$PROJECT_ROOT"
mkdir -p logs docs/exp_lbf
exec >> "$PROJECT_ROOT/logs/ppo_lbf_v2_${PBS_ARRAY_INDEX}.log" 2>&1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
source /apps/miniconda3/etc/profile.d/conda.sh
conda activate marl
# lbforaging must be installed in the marl env (login node, ONCE):
#   conda activate marl && pip install lbforaging
# Verify BEFORE submitting:  python -c "import lbforaging; print('ok')"

# PRE-CONDITIONS: local smoke PART 2 PASS + calibration "Gate PASSED".
python experiments/exp_ppo_lbf.py \
    --run_idx "$PBS_ARRAY_INDEX" \
    --timesteps 2000000 \
    --out docs/exp_lbf/ppo_lbf_v2_raw_data.csv
