#!/bin/bash
#PBS -N lbf_hz_loww
#PBS -q cpu
#PBS -J 0-119
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=02:00:00
#PBS -o logs/
#PBS -e logs/
#PBS -j oe
set -euo pipefail
PROJECT_ROOT="$HOME/prospect-theory"
cd "$PROJECT_ROOT"
mkdir -p logs docs/expMAPPO_lbf_horizon_figures
source /apps/miniconda3/etc/profile.d/conda.sh
conda activate marl
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1

python experiments/exp_mappo_lbf_horizon_loww.py \
    --run_idx "$PBS_ARRAY_INDEX" \
    --out docs/expMAPPO_lbf_horizon_figures/mappo_lbf_horizon_loww_raw_data.csv
