#!/bin/bash
#PBS -N snr_analyze
#PBS -o logs/snr_analyze.out
#PBS -e logs/snr_analyze.err
#PBS -l ncpus=1
#PBS -l walltime=00:20:00
#PBS -q cpu

# --- aggregate the SNR sweep and locate the crossing vs empirical w_crit ---
cd "$PBS_O_WORKDIR"
mkdir -p logs

module load compiler/anaconda3
eval "$(conda shell.bash hook)"
conda activate marl

python3 experiments/analyze_snr.py \
    --csv docs/expSNR_figures/expSNR_raw_data.csv \
    --kappa_c 0.0
