\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Behavioral decomposition of the collapse boundary. Each curve shows $P(\mathrm  {collapse} \mid w)$ at 300k steps. The null ($\alpha {=}\beta {=}1$, gray dashed) is the structural baseline. The $\lambda {=}1$, $\alpha {=}\beta {=}0.88$ curve (blue) shifts \emph  {left} of the null by 0.100, indicating that probability weighting alone facilitates coordination. The $\lambda {=}3$ (orange) and $\lambda {=}7$ (red) curves shift progressively \emph  {right}, indicating that loss aversion raises the centralization requirement. Vertical dashed lines mark $w_{\mathrm  {crit}}$ estimates; shaded bands show bootstrap 95\% confidence intervals. }}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:decomposition}{{2}{7}{Behavioral decomposition of the collapse boundary. Each curve shows $P(\mathrm {collapse} \mid w)$ at 300k steps. The null ($\alpha {=}\beta {=}1$, gray dashed) is the structural baseline. The $\lambda {=}1$, $\alpha {=}\beta {=}0.88$ curve (blue) shifts \emph {left} of the null by 0.100, indicating that probability weighting alone facilitates coordination. The $\lambda {=}3$ (orange) and $\lambda {=}7$ (red) curves shift progressively \emph {right}, indicating that loss aversion raises the centralization requirement. Vertical dashed lines mark $\wcrit $ estimates; shaded bands show bootstrap 95\% confidence intervals}{figure.caption.4}{}}
\newlabel{fig:decomposition@cref}{{[figure][2][]2}{[1][7][]7}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Behavioral Phase Boundary}{7}{subsection.5.3}\protected@file@percent }
\newlabel{sec:results_behavioral}{{5.3}{7}{Behavioral Phase Boundary}{subsection.5.3}{}}
\newlabel{sec:results_behavioral@cref}{{[subsection][3][5]5.3}{[1][6][]7}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Full loss-aversion sweep: fitted collapse-probability curves $P(\mathrm  {collapse}\mid w)$ for $\lambda = 1,\ldots  ,7$ ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per cell). The family shifts coherently rightward as loss aversion grows---each increment of $\lambda $ raises the centralization $w$ required to avert collapse---with the vertical dashed $w_{\mathrm  {crit}}$ lines ordered accordingly. The curves steepen and crowd together at high $\lambda $, the quasi-separation plateau discussed in \Cref  {sec:results_behavioral}. }}{8}{figure.caption.5}\protected@file@percent }
\newlabel{fig:lambda_curves}{{3}{8}{Full loss-aversion sweep: fitted collapse-probability curves $P(\mathrm {collapse}\mid w)$ for $\lambda = 1,\ldots ,7$ ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per cell). The family shifts coherently rightward as loss aversion grows---each increment of $\lambda $ raises the centralization $w$ required to avert collapse---with the vertical dashed $\wcrit $ lines ordered accordingly. The curves steepen and crowd together at high $\lambda $, the quasi-separation plateau discussed in \Cref {sec:results_behavioral}}{figure.caption.5}{}}
\newlabel{fig:lambda_curves@cref}{{[figure][3][]3}{[1][7][]8}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces $w_{\mathrm  {crit}}$ as a function of loss aversion $\lambda \in \{1,\ldots  ,7\}$ ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per cell). Error bars show bootstrap 95\% confidence intervals. The seven-point trend rises monotonically through $\lambda {=}5$ and then saturates; the non-overlapping CIs between $\lambda {=}1$ and $\lambda {=}7$ confirm the behavioral claim. The $\lambda \in \{5,7\}$ CIs reflect quasi-complete separation and should be read with caution (\Cref  {sec:results_behavioral}). }}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:wcrit_lambda}{{4}{8}{$\wcrit $ as a function of loss aversion $\lambda \in \{1,\ldots ,7\}$ ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per cell). Error bars show bootstrap 95\% confidence intervals. The seven-point trend rises monotonically through $\lambda {=}5$ and then saturates; the non-overlapping CIs between $\lambda {=}1$ and $\lambda {=}7$ confirm the behavioral claim. The $\lambda \in \{5,7\}$ CIs reflect quasi-complete separation and should be read with caution (\Cref {sec:results_behavioral})}{figure.caption.6}{}}
\newlabel{fig:wcrit_lambda@cref}{{[figure][4][]4}{[1][7][]8}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Full loss-aversion sweep ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per $(w,\lambda )$ cell, $n{=}100$ runs per $\lambda $). $w_{\mathrm  {crit}}$ with bootstrap 95\% CIs. $^{\dagger }$Slope/p-value unreliable due to quasi-complete separation; $w_{\mathrm  {crit}}$ from bootstrap only.}}{9}{table.caption.7}\protected@file@percent }
\newlabel{tab:lambda_sweep}{{2}{9}{Full loss-aversion sweep ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per $(w,\lambda )$ cell, $n{=}100$ runs per $\lambda $). $\wcrit $ with bootstrap 95\% CIs. $^{\dagger }$Slope/p-value unreliable due to quasi-complete separation; $\wcrit $ from bootstrap only}{table.caption.7}{}}
\newlabel{tab:lambda_sweep@cref}{{[table][2][]2}{[1][7][]9}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Three-way behavioral decomposition of $w_{\mathrm  {crit}}$ relative to the null model. ``Significant'' denotes that the conservative difference confidence interval excludes zero. $^{\dagger }$For $\lambda {=}7$, $w_{\mathrm  {crit}}$ is from bootstrap only; see footnote in \Cref  {sec:results_behavioral}.}}{9}{table.caption.8}\protected@file@percent }
\newlabel{tab:decomposition}{{3}{9}{Three-way behavioral decomposition of $\wcrit $ relative to the null model. ``Significant'' denotes that the conservative difference confidence interval excludes zero. $^{\dagger }$For $\lambda {=}7$, $\wcrit $ is from bootstrap only; see footnote in \Cref {sec:results_behavioral}}{table.caption.8}{}}
\newlabel{tab:decomposition@cref}{{[table][3][]3}{[1][9][]9}{}{}{}}
