\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Behavioral decomposition and full loss-aversion sweep on the supply chain (PPO, 300k steps, 20 seeds per cell). Each curve is the Firth-fitted $P(\mathrm  {collapse}\mid w)$; vertical dotted lines mark $w_{\mathrm  {crit}}$. The null ($\alpha {=}\beta {=}1$, gray dashed) is the structural baseline ($w_{\mathrm  {crit}}{=}0.685$). Probability-weighting \emph  {curvature} alone ($\lambda {=}1$, $\alpha {=}\beta {=}0.88$) shifts $w_{\mathrm  {crit}}$ \emph  {left} of the null---facilitating coordination---while \emph  {loss aversion} ($\lambda {=}2,\ldots  ,7$, $\alpha {=}\beta {=}0.88$) shifts it \emph  {right} (rising, then saturating). The two prospect-theory components thus move the boundary in opposite directions, and the full sweep traces the resulting $w_{\mathrm  {crit}}(\lambda )$ progression in one panel. }}{11}{figure.caption.5}\protected@file@percent }
\newlabel{fig:decomposition}{{2}{11}{Behavioral decomposition and full loss-aversion sweep on the supply chain (PPO, 300k steps, 20 seeds per cell). Each curve is the Firth-fitted $P(\mathrm {collapse}\mid w)$; vertical dotted lines mark $\wcrit $. The null ($\alpha {=}\beta {=}1$, gray dashed) is the structural baseline ($\wcrit {=}0.685$). Probability-weighting \emph {curvature} alone ($\lambda {=}1$, $\alpha {=}\beta {=}0.88$) shifts $\wcrit $ \emph {left} of the null---facilitating coordination---while \emph {loss aversion} ($\lambda {=}2,\ldots ,7$, $\alpha {=}\beta {=}0.88$) shifts it \emph {right} (rising, then saturating). The two prospect-theory components thus move the boundary in opposite directions, and the full sweep traces the resulting $\wcrit (\lambda )$ progression in one panel}{figure.caption.5}{}}
\newlabel{fig:decomposition@cref}{{[figure][2][]2}{[1][10][]11}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Full loss-aversion sweep ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per $(w,\lambda )$ cell, $n{=}100$ runs per $\lambda $). $w_{\mathrm  {crit}}$ with bootstrap 95\% CIs. Slope and $p$ are from \emph  {Firth penalized} logistic regression (Jeffreys-prior), which is stable under steep transitions; all seven slopes are significant ($p<10^{-3}$). The Firth $w_{\mathrm  {crit}}=-b_0/b_1$ agrees with the bootstrap estimate at every $\lambda $ (max.\ deviation $0.019$), confirming that the very large unpenalized MLE slopes previously seen at $\lambda {=}5,7$ were a fitting artifact, not separation.}}{11}{table.caption.6}\protected@file@percent }
\newlabel{tab:lambda_sweep}{{3}{11}{Full loss-aversion sweep ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per $(w,\lambda )$ cell, $n{=}100$ runs per $\lambda $). $\wcrit $ with bootstrap 95\% CIs. Slope and $p$ are from \emph {Firth penalized} logistic regression (Jeffreys-prior), which is stable under steep transitions; all seven slopes are significant ($p<10^{-3}$). The Firth $\wcrit =-b_0/b_1$ agrees with the bootstrap estimate at every $\lambda $ (max.\ deviation $0.019$), confirming that the very large unpenalized MLE slopes previously seen at $\lambda {=}5,7$ were a fitting artifact, not separation}{table.caption.6}{}}
\newlabel{tab:lambda_sweep@cref}{{[table][3][]3}{[1][10][]11}{}{}{}}
\citation{mengesha2025}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Three-way behavioral decomposition of $w_{\mathrm  {crit}}$ relative to the null model. ``Significant'' denotes that the conservative difference confidence interval excludes zero. $^{\dagger }$For $\lambda {=}7$, $w_{\mathrm  {crit}}$ is from bootstrap only; see footnote in Section~\ref {sec:results_behavioral}.}}{12}{table.caption.7}\protected@file@percent }
