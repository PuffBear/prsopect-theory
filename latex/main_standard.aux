\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Centralized-critic MAPPO on the supply chain: fitted collapse-probability curves $P(\mathrm  {collapse}\mid w)$ for $\lambda =1,\ldots  ,7$ ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per cell, 700 runs). As under PPO, the family shifts rightward as loss aversion grows---each increment of $\lambda $ raises the centralization required to avert collapse---confirming the effect is not an artifact of independent PPO. The PPO-vs-MAPPO $w_{\mathrm  {crit}}(\lambda )$ comparison is shown alongside MPE in \Cref  {fig:generalization}.}}{24}{figure.caption.17}\protected@file@percent }
\newlabel{fig:mappo_curves}{{7}{24}{Centralized-critic MAPPO on the supply chain: fitted collapse-probability curves $P(\mathrm {collapse}\mid w)$ for $\lambda =1,\ldots ,7$ ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per cell, 700 runs). As under PPO, the family shifts rightward as loss aversion grows---each increment of $\lambda $ raises the centralization required to avert collapse---confirming the effect is not an artifact of independent PPO. The PPO-vs-MAPPO $\wcrit (\lambda )$ comparison is shown alongside MPE in \Cref {fig:generalization}}{figure.caption.17}{}}
\newlabel{fig:mappo_curves@cref}{{[figure][7][]7}{[1][24][]24}{}{}{}}
