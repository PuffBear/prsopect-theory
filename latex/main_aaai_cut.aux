\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {The loss-aversion effect generalizes.} Critical centralization $w_{\mathrm  {crit}}$ versus loss aversion $\lambda $ for four settings: the supply chain under PPO (blue) and under centralized-critic MAPPO (green), MPE Cooperative Navigation under MAPPO (red), and Level-Based Foraging under MAPPO (purple). Error bars are bootstrap 95\% CIs. Across three structurally distinct environments and two algorithms, $w_{\mathrm  {crit}}$ rises with $\lambda $ then saturates---loss aversion raises the centralization a cooperative system needs to avert collapse. The \emph  {direction} is what generalizes; absolute levels differ (most at $\lambda {=}1$) and the curvature sign and exact functional form are substrate-specific. (LBF's high-$\lambda $ points saturate against the centralization ceiling and are reported as exploratory; see Section\nobreakspace  {}\ref  {sec:lbf}.)\relax }}{9}{figure.caption.31}\protected@file@percent }
\newlabel{fig:generalization}{{4}{9}{\textbf {The loss-aversion effect generalizes.} Critical centralization $\wcrit $ versus loss aversion $\lambda $ for four settings: the supply chain under PPO (blue) and under centralized-critic MAPPO (green), MPE Cooperative Navigation under MAPPO (red), and Level-Based Foraging under MAPPO (purple). Error bars are bootstrap 95\% CIs. Across three structurally distinct environments and two algorithms, $\wcrit $ rises with $\lambda $ then saturates---loss aversion raises the centralization a cooperative system needs to avert collapse. The \emph {direction} is what generalizes; absolute levels differ (most at $\lambda {=}1$) and the curvature sign and exact functional form are substrate-specific. (LBF's high-$\lambda $ points saturate against the centralization ceiling and are reported as exploratory; see Section~\ref {sec:lbf}.)\relax }{figure.caption.31}{}}
\newlabel{fig:generalization@cref}{{[figure][4][]4}{[1][8][]9}}
