\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces The derived affine loss-aversion law \textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:wcrit_lambda}\unskip \@@italiccorr )}} against the full sweep. Points are the measured $w_{\mathrm  {crit}}(\lambda )$ for $\lambda =1,\ldots  ,7$ with bootstrap 95\% CIs (\Cref  {tab:lambda_sweep}); the line is the one-parameter law with $g/c$ fixed at the $\lambda {=}1$ baseline and a single theory-bounded slope $\rho =0.61$. The law tracks all seven points to RMSE $0.014$, with a mild concave residual at the high-$\lambda $ saturation plateau.\relax }}{14}{figure.caption.58}\protected@file@percent }
\newlabel{fig:affine_law}{{7}{14}{The derived affine loss-aversion law \eqref {eq:wcrit_lambda} against the full sweep. Points are the measured $\wcrit (\lambda )$ for $\lambda =1,\ldots ,7$ with bootstrap 95\% CIs (\Cref {tab:lambda_sweep}); the line is the one-parameter law with $g/c$ fixed at the $\lambda {=}1$ baseline and a single theory-bounded slope $\rho =0.61$. The law tracks all seven points to RMSE $0.014$, with a mild concave residual at the high-$\lambda $ saturation plateau.\relax }{figure.caption.58}{}}
\newlabel{fig:affine_law@cref}{{[figure][7][2147483647]7}{[1][13][]14}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces MAPPO on MPE Cooperative Navigation: fitted collapse-probability curves $P(\mathrm  {collapse}\mid w)$ for the full loss-aversion sweep $\lambda {=}1,\ldots  ,7$ ($\alpha {=}\beta {=}0.88$, centralized critic, 50-step horizon, 20 seeds per cell; collapse = per-step landmark occupancy below $\theta {=}0.144$, recalibrated from this run's null $w{=}0$/$w{=}1$ endpoints). The family shifts rightward as $\lambda $ grows, with vertical dashed $w_{\mathrm  {crit}}$ lines ordered accordingly---the same loss-aversion signature found in the supply chain, recovered under a different environment and a different (centralized-critic) algorithm.\relax }}{14}{figure.caption.59}\protected@file@percent }
\newlabel{fig:mpe_lambda_curves}{{8}{14}{MAPPO on MPE Cooperative Navigation: fitted collapse-probability curves $P(\mathrm {collapse}\mid w)$ for the full loss-aversion sweep $\lambda {=}1,\ldots ,7$ ($\alpha {=}\beta {=}0.88$, centralized critic, 50-step horizon, 20 seeds per cell; collapse = per-step landmark occupancy below $\theta {=}0.144$, recalibrated from this run's null $w{=}0$/$w{=}1$ endpoints). The family shifts rightward as $\lambda $ grows, with vertical dashed $\wcrit $ lines ordered accordingly---the same loss-aversion signature found in the supply chain, recovered under a different environment and a different (centralized-critic) algorithm.\relax }{figure.caption.59}{}}
\newlabel{fig:mpe_lambda_curves@cref}{{[figure][8][2147483647]8}{[1][13][]14}}
