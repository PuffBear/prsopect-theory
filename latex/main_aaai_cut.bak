\end{tabular}
\end{table}

\noindent\textbf{Abbreviations.} MARL (multi-agent reinforcement learning);
CTDE (centralized training, decentralized execution); CPT (cumulative prospect
theory); PPO (proximal policy optimization); MAPPO (multi-agent PPO with a
centralized critic); MPE (multi-agent particle environments); SNR
(signal-to-noise ratio); MLE (maximum-likelihood estimate);
CI (confidence interval).

