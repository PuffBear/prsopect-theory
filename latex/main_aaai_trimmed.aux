\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces $P(\mathrm  {collapse})$ in $(w, T)$ space. Each cell shows the empirical collapse fraction across 20 seeds. The 150k and 300k rows are from Exp\nobreakspace  {}A ($\alpha {=}\beta {=}1$); the 600k row is from Exp\nobreakspace  {}T ($\alpha {=}\beta {=}0.88$). Because $\alpha {=}\beta {=}0.88$ shifts $w_{\mathrm  {crit}}$ left by 0.100 (§\ref  {sec:results_behavioral}), the apparent 300k$\to $600k slide is partially curvature-inflated. Under matched $\alpha {=}\beta {=}1$ conditions (Exp\nobreakspace  {}0b), $P(\mathrm  {collapse}\mid w{=}0.6) = 0.35$ and $P(\mathrm  {collapse}\mid w{=}0.7) = 0.20$ at 600k, confirming that metastability holds with $\alpha {=}\beta $ held constant; only the magnitude is curvature-inflated in this figure. \relax }}{3}{figure.caption.8}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:heatmap}{{1}{3}{$P(\mathrm {collapse})$ in $(w, T)$ space. Each cell shows the empirical collapse fraction across 20 seeds. The 150k and 300k rows are from Exp~A ($\alpha {=}\beta {=}1$); the 600k row is from Exp~T ($\alpha {=}\beta {=}0.88$). Because $\alpha {=}\beta {=}0.88$ shifts $\wcrit $ left by 0.100 (§\ref {sec:results_behavioral}), the apparent 300k$\to $600k slide is partially curvature-inflated. Under matched $\alpha {=}\beta {=}1$ conditions (Exp~0b), $P(\mathrm {collapse}\mid w{=}0.6) = 0.35$ and $P(\mathrm {collapse}\mid w{=}0.7) = 0.20$ at 600k, confirming that metastability holds with $\alpha {=}\beta $ held constant; only the magnitude is curvature-inflated in this figure. \relax }{figure.caption.8}{}}
\newlabel{fig:heatmap@cref}{{[figure][1][]1}{[1][3][]3}}
