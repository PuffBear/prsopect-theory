\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Mean-field mechanism versus empirics. (a)\nobreakspace  {}Mechanism (schematic): the cooperative gradient signal grows with centralisation ($\propto w\,g$) while partner exploration injects a roughly $w$-independent noise floor; $w_{\mathrm  {crit}}$ is the signal-to-noise crossing \textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:snr}\unskip \@@italiccorr )}}, below which the lazy policy is the effective attractor. (b)\nobreakspace  {}Schematic of the \emph  {derived affine} loss-aversion law \textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:wcrit_lambda}\unskip \@@italiccorr )}}: CPT predicts $\phi (\lambda )=1+\rho (\lambda -1)$ with slope $\rho \in [0,1]$; the single data-implied slope $\rho =0.61$ respects the bound. The quantitative fit against the full seven-point sweep is shown separately in \Cref  {fig:affine_law}. (c)\nobreakspace  {}The Kramers escape picture predicts the metastable leftward slide of $w_{\mathrm  {crit}}$ with training horizon $T$.\relax }}{8}{figure.caption.29}\protected@file@percent }
\newlabel{fig:meanfield}{{3}{8}{Mean-field mechanism versus empirics. (a)~Mechanism (schematic): the cooperative gradient signal grows with centralisation ($\propto w\,g$) while partner exploration injects a roughly $w$-independent noise floor; $\wcrit $ is the signal-to-noise crossing \eqref {eq:snr}, below which the lazy policy is the effective attractor. (b)~Schematic of the \emph {derived affine} loss-aversion law \eqref {eq:wcrit_lambda}: CPT predicts $\phi (\lambda )=1+\rho (\lambda -1)$ with slope $\rho \in [0,1]$; the single data-implied slope $\rho =0.61$ respects the bound. The quantitative fit against the full seven-point sweep is shown separately in \Cref {fig:affine_law}. (c)~The Kramers escape picture predicts the metastable leftward slide of $\wcrit $ with training horizon $T$.\relax }{figure.caption.29}{}}
\newlabel{fig:meanfield@cref}{{[figure][3][]3}{[1][8][]8}}
\newlabel{eq:wcrit_lambda}{{13}{8}{Derived form of the loss-aversion law}{equation.0.13}{}}
\newlabel{eq:wcrit_lambda@cref}{{[equation][13][]13}{[1][8][]8}}
