\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces MAPPO on MPE Cooperative Navigation: fitted collapse-probability curves $P(\mathrm  {collapse}\mid w)$ for the full loss-aversion sweep $\lambda {=}1,\ldots  ,7$ ($\alpha {=}\beta {=}0.88$, centralized critic, 50-step horizon, 20 seeds per cell; collapse = per-step landmark occupancy below $\theta {=}0.144$, recalibrated from this run's null $w{=}0$/$w{=}1$ endpoints). The family shifts rightward as $\lambda $ grows, with vertical dashed $w_{\mathrm  {crit}}$ lines ordered accordingly---the same loss-aversion signature found in the supply chain, recovered under a different environment and a different (centralized-critic) algorithm.\relax }}{11}{figure.caption.39}\protected@file@percent }
\newlabel{fig:mpe_lambda_curves}{{6}{11}{MAPPO on MPE Cooperative Navigation: fitted collapse-probability curves $P(\mathrm {collapse}\mid w)$ for the full loss-aversion sweep $\lambda {=}1,\ldots ,7$ ($\alpha {=}\beta {=}0.88$, centralized critic, 50-step horizon, 20 seeds per cell; collapse = per-step landmark occupancy below $\theta {=}0.144$, recalibrated from this run's null $w{=}0$/$w{=}1$ endpoints). The family shifts rightward as $\lambda $ grows, with vertical dashed $\wcrit $ lines ordered accordingly---the same loss-aversion signature found in the supply chain, recovered under a different environment and a different (centralized-critic) algorithm.\relax }{figure.caption.39}{}}
\newlabel{fig:mpe_lambda_curves@cref}{{[figure][6][]6}{[1][10][]11}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Centralized-critic MAPPO on the supply chain: fitted collapse-probability curves $P(\mathrm  {collapse}\mid w)$ for $\lambda =1,\ldots  ,7$ ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per cell, 700 runs). As under PPO, the family shifts rightward as loss aversion grows---each increment of $\lambda $ raises the centralization required to avert collapse---confirming the effect is not an artifact of independent PPO. The PPO-vs-MAPPO $w_{\mathrm  {crit}}(\lambda )$ comparison is shown alongside MPE in \Cref  {fig:generalization}.\relax }}{11}{figure.caption.42}\protected@file@percent }
\newlabel{fig:mappo_curves}{{7}{11}{Centralized-critic MAPPO on the supply chain: fitted collapse-probability curves $P(\mathrm {collapse}\mid w)$ for $\lambda =1,\ldots ,7$ ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per cell, 700 runs). As under PPO, the family shifts rightward as loss aversion grows---each increment of $\lambda $ raises the centralization required to avert collapse---confirming the effect is not an artifact of independent PPO. The PPO-vs-MAPPO $\wcrit (\lambda )$ comparison is shown alongside MPE in \Cref {fig:generalization}.\relax }{figure.caption.42}{}}
\newlabel{fig:mappo_curves@cref}{{[figure][7][]7}{[1][11][]11}}
