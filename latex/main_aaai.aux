\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {The loss-aversion effect generalizes.} Critical centralization $w_{\mathrm  {crit}}$ versus loss aversion $\lambda $ for four settings: the supply chain under PPO (blue) and under centralized-critic MAPPO (green), MPE Cooperative Navigation under MAPPO (red), and Level-Based Foraging under MAPPO (purple). Error bars are bootstrap 95\% CIs. Across three structurally distinct environments and two algorithms, $w_{\mathrm  {crit}}$ rises with $\lambda $ then saturates---loss aversion raises the centralization a cooperative system needs to avert collapse. The \emph  {direction} is what generalizes; absolute levels differ (most at $\lambda {=}1$) and the curvature sign and exact functional form are substrate-specific. (LBF's high-$\lambda $ points saturate against the centralization ceiling and are reported as exploratory; see Section~\ref {sec:lbf}.)}}{9}{figure.caption.27}\protected@file@percent }
\newlabel{fig:generalization}{{5}{9}{\textbf {The loss-aversion effect generalizes.} Critical centralization $\wcrit $ versus loss aversion $\lambda $ for four settings: the supply chain under PPO (blue) and under centralized-critic MAPPO (green), MPE Cooperative Navigation under MAPPO (red), and Level-Based Foraging under MAPPO (purple). Error bars are bootstrap 95\% CIs. Across three structurally distinct environments and two algorithms, $\wcrit $ rises with $\lambda $ then saturates---loss aversion raises the centralization a cooperative system needs to avert collapse. The \emph {direction} is what generalizes; absolute levels differ (most at $\lambda {=}1$) and the curvature sign and exact functional form are substrate-specific. (LBF's high-$\lambda $ points saturate against the centralization ceiling and are reported as exploratory; see Section~\ref {sec:lbf}.)}{figure.caption.27}{}}
\newlabel{fig:generalization@cref}{{[figure][5][]5}{[1][8][]9}{}{}{}}
\citation{christianos2020shared}
