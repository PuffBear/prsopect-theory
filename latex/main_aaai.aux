\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Mean-field mechanism versus empirics. (a)~Mechanism (schematic): the cooperative gradient signal grows with centralisation ($\propto w\,g$) while partner exploration injects a roughly $w$-independent noise floor; $w_{\mathrm  {crit}}$ is the signal-to-noise crossing \eqref  {eq:snr}, below which the lazy policy is the effective attractor. (b)~Schematic of the \emph  {derived affine} loss-aversion law \eqref  {eq:wcrit_lambda}: CPT predicts $\phi (\lambda )=1+\rho (\lambda -1)$ with slope $\rho \in [0,1]$; the single data-implied slope $\rho =0.61$ respects the bound. The quantitative fit against the full seven-point sweep is shown separately in \Cref  {fig:affine_law}. (c)~The Kramers escape picture predicts the metastable leftward slide of $w_{\mathrm  {crit}}$ with training horizon $T$.}}{8}{figure.caption.22}\protected@file@percent }
\newlabel{fig:meanfield}{{3}{8}{Mean-field mechanism versus empirics. (a)~Mechanism (schematic): the cooperative gradient signal grows with centralisation ($\propto w\,g$) while partner exploration injects a roughly $w$-independent noise floor; $\wcrit $ is the signal-to-noise crossing \eqref {eq:snr}, below which the lazy policy is the effective attractor. (b)~Schematic of the \emph {derived affine} loss-aversion law \eqref {eq:wcrit_lambda}: CPT predicts $\phi (\lambda )=1+\rho (\lambda -1)$ with slope $\rho \in [0,1]$; the single data-implied slope $\rho =0.61$ respects the bound. The quantitative fit against the full seven-point sweep is shown separately in \Cref {fig:affine_law}. (c)~The Kramers escape picture predicts the metastable leftward slide of $\wcrit $ with training horizon $T$}{figure.caption.22}{}}
\newlabel{fig:meanfield@cref}{{[figure][3][]3}{[1][8][]8}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{Derived form of the loss-aversion law}{8}{section*.21}\protected@file@percent }
\newlabel{eq:wcrit_lambda}{{13}{8}{Derived form of the loss-aversion law}{equation.13}{}}
