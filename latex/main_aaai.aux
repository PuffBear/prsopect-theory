\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {The loss-aversion effect generalizes.} Critical centralization $w_{\mathrm  {crit}}$ versus loss aversion $\lambda $ for three settings: the supply chain under PPO (blue) and under centralized-critic MAPPO (green), and MPE Cooperative Navigation under MAPPO (red). Error bars are bootstrap 95\% CIs. Across two environments and two algorithms, $w_{\mathrm  {crit}}$ rises monotonically with $\lambda $---loss aversion raises the centralization a cooperative system needs to avert collapse. The \emph  {direction} is what generalizes; absolute levels differ (most at $\lambda {=}1$) and the curvature sign and exact functional form are substrate-specific.\relax }}{8}{figure.caption.26}\protected@file@percent }
\newlabel{fig:generalization}{{5}{8}{\textbf {The loss-aversion effect generalizes.} Critical centralization $\wcrit $ versus loss aversion $\lambda $ for three settings: the supply chain under PPO (blue) and under centralized-critic MAPPO (green), and MPE Cooperative Navigation under MAPPO (red). Error bars are bootstrap 95\% CIs. Across two environments and two algorithms, $\wcrit $ rises monotonically with $\lambda $---loss aversion raises the centralization a cooperative system needs to avert collapse. The \emph {direction} is what generalizes; absolute levels differ (most at $\lambda {=}1$) and the curvature sign and exact functional form are substrate-specific.\relax }{figure.caption.26}{}}
\newlabel{fig:generalization@cref}{{[figure][5][]5}{[1][7][]8}}
