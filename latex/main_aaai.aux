\@writefile{toc}{\contentsline {paragraph}{Scope.}{8}{section*.25}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The derived affine loss-aversion law \eqref  {eq:wcrit_lambda} against the full sweep. Points are the measured $w_{\mathrm  {crit}}(\lambda )$ for $\lambda =1,\ldots  ,7$ with bootstrap 95\% CIs (\Cref  {tab:lambda_sweep}); the line is the one-parameter law with $g/c$ fixed at the $\lambda {=}1$ baseline and a single theory-bounded slope $\rho =0.61$. The law tracks all seven points to RMSE $0.014$, with a mild concave residual at the high-$\lambda $ saturation plateau.}}{8}{figure.caption.23}\protected@file@percent }
\newlabel{fig:affine_law}{{4}{8}{The derived affine loss-aversion law \eqref {eq:wcrit_lambda} against the full sweep. Points are the measured $\wcrit (\lambda )$ for $\lambda =1,\ldots ,7$ with bootstrap 95\% CIs (\Cref {tab:lambda_sweep}); the line is the one-parameter law with $g/c$ fixed at the $\lambda {=}1$ baseline and a single theory-bounded slope $\rho =0.61$. The law tracks all seven points to RMSE $0.014$, with a mild concave residual at the high-$\lambda $ saturation plateau}{figure.caption.23}{}}
\newlabel{fig:affine_law@cref}{{[figure][4][]4}{[1][8][]8}{}{}{}}
