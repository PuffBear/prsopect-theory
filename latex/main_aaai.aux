\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces MAPPO on MPE Cooperative Navigation: fitted collapse-probability curves $P(\mathrm  {collapse}\mid w)$ for the full loss-aversion sweep $\lambda {=}1,\ldots  ,7$ ($\alpha {=}\beta {=}0.88$, centralized critic, 50-step horizon, 10 seeds per cell; collapse = per-step landmark occupancy below the calibrated $\theta {=}0.164$). The family shifts rightward as $\lambda $ grows, with vertical dashed $w_{\mathrm  {crit}}$ lines ordered accordingly---the same loss-aversion signature found in the supply chain, recovered under a different environment and a different (centralized-critic) algorithm.\relax }}{9}{figure.caption.33}\protected@file@percent }
\newlabel{fig:mpe_lambda_curves}{{6}{9}{MAPPO on MPE Cooperative Navigation: fitted collapse-probability curves $P(\mathrm {collapse}\mid w)$ for the full loss-aversion sweep $\lambda {=}1,\ldots ,7$ ($\alpha {=}\beta {=}0.88$, centralized critic, 50-step horizon, 10 seeds per cell; collapse = per-step landmark occupancy below the calibrated $\theta {=}0.164$). The family shifts rightward as $\lambda $ grows, with vertical dashed $\wcrit $ lines ordered accordingly---the same loss-aversion signature found in the supply chain, recovered under a different environment and a different (centralized-critic) algorithm.\relax }{figure.caption.33}{}}
\newlabel{fig:mpe_lambda_curves@cref}{{[figure][6][]6}{[1][9][]9}}
