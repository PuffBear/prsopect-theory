\citation{weng2026}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Mean-field mechanism versus empirics. (a)\nobreakspace  {}Mechanism (schematic): the cooperative gradient signal grows with centralisation ($\propto w\,g$) while partner exploration injects a roughly $w$-independent noise floor; $w_{\mathrm  {crit}}$ is the signal-to-noise crossing \textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:snr}\unskip \@@italiccorr )}}, below which the lazy policy is the effective attractor. (b)\nobreakspace  {}Schematic of the \emph  {derived affine} loss-aversion law \textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:wcrit_lambda}\unskip \@@italiccorr )}}: CPT predicts $\phi (\lambda )=1+\rho (\lambda -1)$ with slope $\rho \in [0,1]$; the single data-implied slope $\rho =0.61$ respects the bound. The quantitative fit against the full seven-point sweep is shown separately in \Cref  {fig:affine_law}. (c)\nobreakspace  {}The Kramers escape picture predicts the metastable leftward slide of $w_{\mathrm  {crit}}$ with training horizon $T$.\relax }}{7}{figure.caption.21}\protected@file@percent }
\newlabel{fig:meanfield}{{3}{7}{Mean-field mechanism versus empirics. (a)~Mechanism (schematic): the cooperative gradient signal grows with centralisation ($\propto w\,g$) while partner exploration injects a roughly $w$-independent noise floor; $\wcrit $ is the signal-to-noise crossing \eqref {eq:snr}, below which the lazy policy is the effective attractor. (b)~Schematic of the \emph {derived affine} loss-aversion law \eqref {eq:wcrit_lambda}: CPT predicts $\phi (\lambda )=1+\rho (\lambda -1)$ with slope $\rho \in [0,1]$; the single data-implied slope $\rho =0.61$ respects the bound. The quantitative fit against the full seven-point sweep is shown separately in \Cref {fig:affine_law}. (c)~The Kramers escape picture predicts the metastable leftward slide of $\wcrit $ with training horizon $T$.\relax }{figure.caption.21}{}}
\newlabel{fig:meanfield@cref}{{[figure][3][]3}{[1][7][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The derived affine loss-aversion law \textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:wcrit_lambda}\unskip \@@italiccorr )}} against the full sweep. Points are the measured $w_{\mathrm  {crit}}(\lambda )$ for $\lambda =1,\ldots  ,7$ with bootstrap 95\% CIs (\Cref  {tab:lambda_sweep}); the line is the one-parameter law with $g/c$ fixed at the $\lambda {=}1$ baseline and a single theory-bounded slope $\rho =0.61$. The law tracks all seven points to RMSE $0.014$, with a mild concave residual at the high-$\lambda $ saturation plateau.\relax }}{7}{figure.caption.22}\protected@file@percent }
\newlabel{fig:affine_law}{{4}{7}{The derived affine loss-aversion law \eqref {eq:wcrit_lambda} against the full sweep. Points are the measured $\wcrit (\lambda )$ for $\lambda =1,\ldots ,7$ with bootstrap 95\% CIs (\Cref {tab:lambda_sweep}); the line is the one-parameter law with $g/c$ fixed at the $\lambda {=}1$ baseline and a single theory-bounded slope $\rho =0.61$. The law tracks all seven points to RMSE $0.014$, with a mild concave residual at the high-$\lambda $ saturation plateau.\relax }{figure.caption.22}{}}
\newlabel{fig:affine_law@cref}{{[figure][4][]4}{[1][7][]7}}
