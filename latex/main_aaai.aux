\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces MAPPO on MPE Cooperative Navigation: fitted collapse-probability curves $P(\mathrm  {collapse}\mid w)$ for the full loss-aversion sweep $\lambda {=}1,\ldots  ,7$ ($\alpha {=}\beta {=}0.88$, centralized critic, 50-step horizon, 20 seeds per cell; collapse = per-step landmark occupancy below $\theta {=}0.144$, recalibrated from this run's null $w{=}0$/$w{=}1$ endpoints). The family shifts rightward as $\lambda $ grows, with vertical dashed $w_{\mathrm  {crit}}$ lines ordered accordingly---the same loss-aversion signature found in the supply chain, recovered under a different environment and a different (centralized-critic) algorithm.}}{10}{figure.caption.32}\protected@file@percent }
\newlabel{fig:mpe_lambda_curves}{{6}{10}{MAPPO on MPE Cooperative Navigation: fitted collapse-probability curves $P(\mathrm {collapse}\mid w)$ for the full loss-aversion sweep $\lambda {=}1,\ldots ,7$ ($\alpha {=}\beta {=}0.88$, centralized critic, 50-step horizon, 20 seeds per cell; collapse = per-step landmark occupancy below $\theta {=}0.144$, recalibrated from this run's null $w{=}0$/$w{=}1$ endpoints). The family shifts rightward as $\lambda $ grows, with vertical dashed $\wcrit $ lines ordered accordingly---the same loss-aversion signature found in the supply chain, recovered under a different environment and a different (centralized-critic) algorithm}{figure.caption.32}{}}
\newlabel{fig:mpe_lambda_curves@cref}{{[figure][6][]6}{[1][10][]10}{}{}{}}
