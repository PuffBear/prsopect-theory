\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Behavioral decomposition of the collapse boundary. Each curve shows $P(\mathrm  {collapse} \mid w)$ at 300k steps. The null ($\alpha {=}\beta {=}1$, gray dashed) is the structural baseline. The $\lambda {=}1$, $\alpha {=}\beta {=}0.88$ curve (blue) shifts \emph  {left} of the null by 0.100, indicating that probability weighting alone facilitates coordination. The $\lambda {=}3$ (orange) and $\lambda {=}7$ (red) curves shift progressively \emph  {right}, indicating that loss aversion raises the centralization requirement. Vertical dashed lines mark $w_{\mathrm  {crit}}$ estimates; shaded bands show bootstrap 95\% confidence intervals. \relax }}{4}{figure.caption.12}\protected@file@percent }
\newlabel{fig:decomposition}{{2}{4}{Behavioral decomposition of the collapse boundary. Each curve shows $P(\mathrm {collapse} \mid w)$ at 300k steps. The null ($\alpha {=}\beta {=}1$, gray dashed) is the structural baseline. The $\lambda {=}1$, $\alpha {=}\beta {=}0.88$ curve (blue) shifts \emph {left} of the null by 0.100, indicating that probability weighting alone facilitates coordination. The $\lambda {=}3$ (orange) and $\lambda {=}7$ (red) curves shift progressively \emph {right}, indicating that loss aversion raises the centralization requirement. Vertical dashed lines mark $\wcrit $ estimates; shaded bands show bootstrap 95\% confidence intervals. \relax }{figure.caption.12}{}}
\newlabel{fig:decomposition@cref}{{[figure][2][]2}{[1][4][]4}}
\citation{mengesha2025}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Full loss-aversion sweep: fitted collapse-probability curves $P(\mathrm  {collapse}\mid w)$ for $\lambda = 1,\ldots  ,7$ ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per cell). The family shifts coherently rightward as loss aversion grows---each increment of $\lambda $ raises the centralization $w$ required to avert collapse---with the vertical dashed $w_{\mathrm  {crit}}$ lines ordered accordingly. The curves steepen and crowd together at high $\lambda $, the quasi-separation plateau discussed in Section\nobreakspace  {}\ref  {sec:results_behavioral}. \relax }}{5}{figure.caption.13}\protected@file@percent }
\newlabel{fig:lambda_curves}{{3}{5}{Full loss-aversion sweep: fitted collapse-probability curves $P(\mathrm {collapse}\mid w)$ for $\lambda = 1,\ldots ,7$ ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per cell). The family shifts coherently rightward as loss aversion grows---each increment of $\lambda $ raises the centralization $w$ required to avert collapse---with the vertical dashed $\wcrit $ lines ordered accordingly. The curves steepen and crowd together at high $\lambda $, the quasi-separation plateau discussed in Section~\ref {sec:results_behavioral}. \relax }{figure.caption.13}{}}
\newlabel{fig:lambda_curves@cref}{{[figure][3][]3}{[1][4][]5}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces $w_{\mathrm  {crit}}$ as a function of loss aversion $\lambda \in \{1,\ldots  ,7\}$ ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per cell). Error bars show bootstrap 95\% confidence intervals. The seven-point trend rises monotonically through $\lambda {=}5$ and then saturates; the non-overlapping CIs between $\lambda {=}1$ and $\lambda {=}7$ confirm the behavioral claim. The $\lambda \in \{5,7\}$ CIs are bootstrap estimates on a steep transition resolved by a single interior grid point and should be read with mild caution (Section\nobreakspace  {}\ref  {sec:results_behavioral}). \relax }}{5}{figure.caption.14}\protected@file@percent }
\newlabel{fig:wcrit_lambda}{{4}{5}{$\wcrit $ as a function of loss aversion $\lambda \in \{1,\ldots ,7\}$ ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per cell). Error bars show bootstrap 95\% confidence intervals. The seven-point trend rises monotonically through $\lambda {=}5$ and then saturates; the non-overlapping CIs between $\lambda {=}1$ and $\lambda {=}7$ confirm the behavioral claim. The $\lambda \in \{5,7\}$ CIs are bootstrap estimates on a steep transition resolved by a single interior grid point and should be read with mild caution (Section~\ref {sec:results_behavioral}). \relax }{figure.caption.14}{}}
\newlabel{fig:wcrit_lambda@cref}{{[figure][4][]4}{[1][4][]5}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Full loss-aversion sweep ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per $(w,\lambda )$ cell, $n{=}100$ runs per $\lambda $). $w_{\mathrm  {crit}}$ with bootstrap 95\% CIs. Slope and $p$ are from \emph  {Firth penalized} logistic regression (Jeffreys-prior), which is stable under steep transitions; all seven slopes are significant ($p<10^{-3}$). The Firth $w_{\mathrm  {crit}}=-b_0/b_1$ agrees with the bootstrap estimate at every $\lambda $ (max.\ deviation $0.019$), confirming that the very large unpenalized MLE slopes previously seen at $\lambda {=}5,7$ were a fitting artifact, not separation.\relax }}{5}{table.caption.15}\protected@file@percent }
\newlabel{tab:lambda_sweep}{{2}{5}{Full loss-aversion sweep ($\alpha {=}\beta {=}0.88$, 300k steps, 20 seeds per $(w,\lambda )$ cell, $n{=}100$ runs per $\lambda $). $\wcrit $ with bootstrap 95\% CIs. Slope and $p$ are from \emph {Firth penalized} logistic regression (Jeffreys-prior), which is stable under steep transitions; all seven slopes are significant ($p<10^{-3}$). The Firth $\wcrit =-b_0/b_1$ agrees with the bootstrap estimate at every $\lambda $ (max.\ deviation $0.019$), confirming that the very large unpenalized MLE slopes previously seen at $\lambda {=}5,7$ were a fitting artifact, not separation.\relax }{table.caption.15}{}}
\newlabel{tab:lambda_sweep@cref}{{[table][2][]2}{[1][4][]5}}
