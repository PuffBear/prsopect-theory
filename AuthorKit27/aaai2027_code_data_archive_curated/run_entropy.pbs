#!/bin/bash
#PBS -N exp_entropy
#PBS -o logs/entropy.out
#PBS -e logs/entropy.err
#PBS -l ncpus=1
#PBS -l walltime=06:00:00
#PBS -q cpu
#PBS -J 0-399

# Exploration-noise (entropy coefficient) ablation -- 400 runs.
cd "$PBS_O_WORKDIR"
mkdir -p logs
module load compiler/anaconda3
eval "$(conda shell.bash hook)"
conda activate marl

python3 experiments/exp_entropy_ablation.py \
    --run_idx "${PBS_ARRAY_INDEX}" \
    --timesteps 300000 \
    --out docs/expEnt_figures/expEnt_raw_data.csv
