#!/bin/bash
#PBS -N mappo_lbf_highw
#PBS -o logs/mappo_lbf_highw.out
#PBS -e logs/mappo_lbf_highw.err
#PBS -l ncpus=1
#PBS -l walltime=02:00:00
#PBS -q cpu
#PBS -J 0-159

# High-w extension of the MAPPO-LBF breadth sweep: inserts w=0.90 for every
# condition so the saturated high-lambda (lambda>=4) boundaries in (0.85, 1)
# gain an interior anchor and come off the w-grid ceiling.
#   1 w x (null + lambda=1..7 @ a=b=0.88) x 20 seeds = 160 runs.
# analyze_mappo_lbf.py auto-merges the output (mappo_lbf_highw_raw_data.csv).
#
# GATE before submitting (run locally, must PASS):
#   python experiments/run_lbf_smoke_local.py --train         # PART 2 PASS
#   python experiments/exp_mappo_lbf_highw.py --wiring_check   # WIRING CHECK PASS
cd "$PBS_O_WORKDIR"
mkdir -p logs docs/expMAPPO_lbf_figures
module load compiler/anaconda3
eval "$(conda shell.bash hook)"
conda activate marl
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1

python3 experiments/exp_mappo_lbf_highw.py \
    --run_idx "${PBS_ARRAY_INDEX}" \
    --timesteps 2000000 \
    --out docs/expMAPPO_lbf_figures/mappo_lbf_highw_raw_data.csv
