#!/bin/bash
#PBS -N snr_val
#PBS -o logs/snr.out
#PBS -e logs/snr.err
#PBS -l ncpus=1
#PBS -l walltime=06:00:00
#PBS -q cpu
#PBS -J 0-179

# --- Ashoka HPC (PBS Pro) array job: mean-field SNR validation (180 runs) ---
cd "$PBS_O_WORKDIR"
mkdir -p logs

module load compiler/anaconda3
# conda env for this project
eval "$(conda shell.bash hook)"
conda activate marl

python3 experiments/exp_snr_validation.py \
    --run_idx "${PBS_ARRAY_INDEX}" \
    --timesteps 150000 \
    --window_steps 60000 \
    --out docs/expSNR_figures/expSNR_raw_data.csv
